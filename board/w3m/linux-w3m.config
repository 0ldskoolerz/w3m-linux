# Kernel config mínimo para W3M Linux (x86_64, arranca ISO/USB)
# Generado como base con: make x86_64_defconfig + estos cambios.
# Si usas este archivo directamente con USE_CUSTOM_CONFIG, genera primero:
#   make linux-menuconfig  y guarda tu config aquí.

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y

# arranque
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT2_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CP437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# storage
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y

# video (X fbdev)
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# input
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# red
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_VIRTIO_NET=y
CONFIG_RTL8139=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH9K=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y

# audio (ALSA)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_INTEL8X0=y

# bluetooth
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_RFKILL=y

# power
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
