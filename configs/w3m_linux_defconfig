# W3M Linux — Buildroot defconfig
# Uso: make BR2_EXTERNAL=/ruta/w3m-linux w3m_linux_defconfig

BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_W3M_PATH)/board/w3m/rootfs-overlay"
BR2_TARGET_GENERIC_HOSTNAME="w3m"
BR2_TARGET_GENERIC_ISSUE="W3M Linux — estilo Windows 3.x"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_SYSTEM_DHCP="eth0"
# udhcpc script de red: /etc/init.d/S40net en el overlay arranca DHCP
# automatico en eth0 y wlan0 con reintentos (ver board/w3m/)
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y

# toolchain
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_AS_KERNEL=y

# kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.32"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_W3M_PATH)/board/w3m/linux-w3m.config"
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# busybox userland (base del sistema)
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_W3M_PATH)/board/w3m/busybox-w3m.config"

# filesystems / discos
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_FDISK=y
BR2_PACKAGE_UTIL_LINUX_BLKID=y

# X11 mínimo
BR2_PACKAGE_XLIB_LIBX11=y
BR2_PACKAGE_XLIB_LIBXFONT2=y
BR2_PACKAGE_XLIB_LIBXAU=y
BR2_PACKAGE_XLIB_LIBXDMCP=y
BR2_PACKAGE_XLIB_LIBXEXT=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_EVDEV=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_XTERM=y

# escritorio propio
BR2_PACKAGE_W3M=y
BR2_PACKAGE_W3M_APPS=y
BR2_PACKAGE_W3M_NET=y

# ---- dependencias de w3m (WM) ----
# lua: plugins del WM (clock, audio, red...) — seleccionada por el paquete,
#      explicita aqui para visibilidad
BR2_PACKAGE_LUA=y

# ---- dependencias de w3m-apps ----
# busybox: motor de fm/task/calc (ls, cp, mv, tar, unzip, awk, ps, free)
BR2_PACKAGE_BUSYBOX=y
# file (file_exists / tipo de archivo en el explorador)
BR2_PACKAGE_FILE=y
BR2_PACKAGE_XLIB_LIBX11=y

# ---- dependencias de w3m-net ----
# net-tools: ifconfig, route, arp, netstat, mii-tool (w3m-ifaces/route/arp/link)
BR2_PACKAGE_NET_TOOLS=y
# traceroute para w3m-ping (busybox traceroute como fallback)
BR2_PACKAGE_TRACEROUTE=y
# motores opcionales de la suite de red
BR2_PACKAGE_NMAP=y
BR2_PACKAGE_TCPDUMP=y
# dig (bind-tools) para el analisis DNS completo de w3m-dns
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# audio (ALSA, no pulseaudio)
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y

# red (sin NetworkManager)
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_IW=y

# bluetooth
BR2_PACKAGE_BLUEZ_UTILS=y

# remoto/debug
BR2_PACKAGE_DROPBEAR=y

# bootloader ISO
BR2_PACKAGE_SYSLINUX=y
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU=y

# sin python/perl/gcc en runtime
# BR2_PACKAGE_PYTHON is not set
# BR2_PACKAGE_PERL is not set
